<main>
  <h1>Round moderation</h1>
  <ul><% it.bans.forEach(function(ban) { %><li><%= ban.latest_display_name %> (<%= ban.player_id %>)
    <form method="post" action="/admin/moderation/unban"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="playerId" value="<%= ban.player_id %>"><button>Unban</button></form>
  </li><% }) %></ul>
  <form method="post" action="/admin/moderation/ban">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <label>Discord user ID <input name="playerId" required></label>
    <label>Display name <input name="displayName"></label>
    <button>Ban for this round</button>
  </form>
</main>
