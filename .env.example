# development, test, or production
NODE_ENV=development
DISCORD_TOKEN=your-discord-token
DISCORD_APPLICATION_ID=your-application-id
DISCORD_GUILD_ID=your-guild-id
# Use an absolute path outside source checkouts/worktrees for operational server deployments.
DATABASE_PATH=C:\absolute\path\herald-of-jams.sqlite
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3000
ADMIN_PASSWORD_HASH=your-scrypt-password-hash
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Production requires both values to be true and a loopback HTTPS reverse proxy.
ADMIN_SECURE_COOKIE=false
TRUST_PROXY=false
# The portable tray writes its own config.env under %LOCALAPPDATA%\Herald of Jams.
